# Bricklytics Backend — Production Environment Variables
# Copy to .env for local development or configure in production host (AWS / Render / Heroku / VPS)

SECRET_KEY=change-this-in-production-to-a-secure-random-secret
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.bricklytics.com

# MongoDB Database Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/bricklytics_db?retryWrites=true&w=majority
MONGODB_DB_NAME=bricklytics_db_user

# Authentication Security
JWT_SECRET_KEY=change-jwt-secret-in-production
JWT_EXPIRATION_HOURS=24

# SMTP Email Alert Settings
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=notifications@bricklytics.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Bricklytics AI <no-reply@bricklytics.com>
