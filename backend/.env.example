# ============================================================
# Bricklytics Backend — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit the actual .env file to version control.
# ============================================================

# Django Core
SECRET_KEY=your-very-secret-key-here-change-in-production
DEBUG=True

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# MongoDB
MONGODB_URI=mongodb://localhost:27017/bricklytics_db
DATABASE_NAME=bricklytics_db

# CORS — comma-separated list of allowed React dev origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Media / Static
MEDIA_URL=/media/
MEDIA_ROOT=media

STATIC_URL=/static/
STATIC_ROOT=staticfiles

# Timezone
TIME_ZONE=Asia/Kolkata

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=DEBUG

# ML Models directory (relative to BASE_DIR)
ML_MODELS_DIR=ml_models

# JWT Authentication Settings
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_EXPIRATION_HOURS=24

# Real Email Service (SMTP Configuration)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=Bricklytics <your-email@gmail.com>

# Verification Code Expiry (Minutes)
VERIFICATION_CODE_EXPIRY_MINUTES=10
MAX_VERIFICATION_ATTEMPTS=5

