# .gitignore — Bricklytics Backend
# ===================================

# Environment
.env
.env.local
.env.production

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual Environment
venv/
.venv/
env/

# Django
*.log
staticfiles/
media/

# Logs (never commit logs)
logs/*.log

# ML Models (large binary files — use artifact storage)
ml_models/*.joblib
ml_models/*.pkl

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# pytest
.pytest_cache/
.coverage
htmlcov/
